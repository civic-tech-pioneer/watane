package mods:toolc@0.1.0;
interface api {
  /// Starts claude with this launch document, as the tool's own request.
  start: func(launch: string) -> string;
  /// Counts the call and answers the count; it asks nothing.
  touch: func() -> u32;
  /// Waits, then counts the call and answers the count.
  slow: func(ms: u32) -> u32;
  /// The calls that `touch`, `slow` and `start` saw, one line each.
  seen: func() -> list<string>;
}
world toolc {
  import watane:host/state@0.1.0;
  import watane:host/streams@0.1.0;
  import watane:host/claude-types@0.1.0;
  import watane:host/claude-code@0.1.0;
  import watane:host/manage@0.1.0;
  export api;
  export watane:host/stream-sink@0.1.0;
}
