package mods:toolbox@0.1.0;
interface api {
  open: func(toolsets: list<string>) -> result<string, string>;
  describe: func(handle: string) -> result<list<string>, string>;
  call: func(handle: string, key: string, tool: string, args: string) -> result<string, string>;
  call-twice: func(handle: string, key: string, tool: string, args: string) -> list<string>;
  open-describe: func(toolsets: list<string>) -> string;
  open-many: func(toolsets: list<string>, n: u32) -> list<string>;
  close: func(handle: string);
  items: func(s: string) -> list<string>;
  ended: func() -> list<string>;
  who: func() -> string;
  start: func(launch: string) -> string;
}
world toolbox {
  import watane:host/state@0.1.0;
  import watane:host/caller@0.1.0;
  import watane:host/streams@0.1.0;
  import watane:host/agent-tools@0.1.0;
  import watane:host/claude-types@0.1.0;
  import watane:host/claude-code@0.1.0;
  export api;
  export watane:host/stream-sink@0.1.0;
}
