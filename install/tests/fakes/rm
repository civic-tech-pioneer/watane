#!/bin/sh
# Fake rm: passes to the real one ($FAKE_REAL/rm) unless the file rm_fault of the test says
# "fail", "sleep" or "term" (line 1) for an argument that matches the glob (line 2). "term" removes
# the fault, then sends TERM to the shell that called it and to that shell's parent (a group signal
# sent from inside the group reaches only the sender on macOS).
if [ -f "$FAKE_STATE/rm_fault" ]; then
  { read -r mode; read -r pat; } < "$FAKE_STATE/rm_fault"
  for a; do
    case $a in
      $pat)
        case $mode in
          fail) echo "fake rm: failing on $a" >&2; exit 1 ;;
          sleep) echo "$a" > "$FAKE_STATE/rm_sleeping"; exec "$FAKE_REAL/sleep" 600 ;;
          term)
            "$FAKE_REAL/rm" -f "$FAKE_STATE/rm_fault"
            pp=$(/bin/ps -o ppid= -p "$PPID")
            kill -s TERM $pp "$PPID"
            exit 1 ;;
        esac ;;
    esac
  done
fi
exec "$FAKE_REAL/rm" "$@"
